{
  "description": "muwi: 세션이 시작될 때 지침을 넣고, 읽은 skill과 서브에이전트를 기록한다. AI가 하려는 일을 막지 않는다",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"", "onFailure": "continue"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"", "onFailure": "continue"}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"", "onFailure": "continue"}]}
    ],
    "PostToolUse": [
      {"matcher": "Skill|Read", "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"", "onFailure": "continue"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" command", "onFailure": "continue"}]}
    ]
  }
}
