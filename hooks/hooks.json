{
  "description": "muwi: 세션이 시작될 때 지침을 넣고, 읽은 skill을 기록하고, 계획을 적지 않은 세션의 파일 수정을 알린다",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Skill|Read", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" nudge" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" guard" }] }
    ]
  }
}
